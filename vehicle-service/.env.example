# Copy to .env and fill. Never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO

# Redis (required for cache + batch jobs)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_KEY_PREFIX=vehicle:challan
BATCH_KEY_PREFIX=vehicle:batch

# Primary vendor (SurePass / RapidAPI). Empty => mock mode (bill-free dev).
PRIMARY_PROVIDER_BASE_URL=
PRIMARY_PROVIDER_API_KEY=
PRIMARY_PROVIDER_TIMEOUT_S=8.0

# RapidAPI RTO (preferred when set). Mirrors backend/.env RAPIDAPI_*.
# Example host: in-rto-vehicle-information-india.p.rapidapi.com
# Base defaults to https://<host>; PATH defaults to /getVehicleInfo.
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_BASE_URL=
RAPIDAPI_PATH=/getVehicleInfo

# Secondary vendor (Attestr / Cashfree). Empty => mock mode.
SECONDARY_PROVIDER_BASE_URL=
SECONDARY_PROVIDER_API_KEY=
SECONDARY_PROVIDER_TIMEOUT_S=8.0

# Resiliency
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=1.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_S=60.0

# Rate limits (per IP, per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BATCH_PER_MINUTE=10

# Batch
BATCH_MAX_VEHICLES=50
BATCH_JOB_TTL_SECONDS=86400

# Optional audit DB (Postgres). Empty disables DB writes (log-only).
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/vehicle
DATABASE_URL=

# Dev: force mock providers even when URLs are set (CI/tests).
MOCK_PROVIDERS=true
