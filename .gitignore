# ==============================================================================
# SENTINEL Platform — Git Ignore Specification
# ==============================================================================

# --- Python & Virtual Environments -------------------------------------------
.venv/
venv/
env/
ENV/
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing & Code Quality --------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.oxlint_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.tsbuildinfo

# --- Environment, Secrets & Local Configuration ------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
# Private keys, certificates with keys, and credential files. The grid
# email/password live in backend/.env (above); never commit them elsewhere.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
secrets.json
service-account*.json
*-service-account.json
*.token
cookies.txt
*cookie*.txt

# --- Local Databases & Runtime State -----------------------------------------
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
backend/sentinel.db*
backend/spool/
spool/

# --- Evidence Snapshots & Media Capture --------------------------------------
backend/snapshots/*
!backend/snapshots/.gitkeep
snapshots/*
!snapshots/.gitkeep

# --- Machine Learning & Large Model Weights ----------------------------------
# (Model weights are large binaries shipped via deployment pipelines / S3)
*.onnx
*.pt
*.pth
*.bin
*.weights
backend/models/*.onnx
backend/models/*.pt
backend/models/*.pth

# --- Local Video Footage & Benchmark Datasets --------------------------------
# Sample footage stays local (evaluators mount their own); result JSONs embed
# timestamps/hostnames from the operator's machine.
data/samples/*.mp4
data/samples/*.mkv
data/samples/*.avi
data/samples/*.mov
data/samples/*.webm
*.mp4
*.mkv
*.avi
*.mov
*.webm
recordings/
footage/
videos/
captures/
bench/results/*.json
bench/results/*.csv

# --- Logs --------------------------------------------------------------------
*.log
logs/
backend/logs/
frontend/logs/

# --- Node & Frontend Build Artifacts -----------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & Operating System Metadata --------------------------------------
.vscode/
.idea/
.claude/
.cursor/
.aider*
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Presentations, Office Documents & Local Assets --------------------------
PPTs/
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls
*.pdf
# Office temp/lock files
~$*.pptx
~$*.docx
~$*.xlsx
