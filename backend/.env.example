# Copy to .env and adjust. Defaults work for local development.

# --- database -------------------------------------------------------------
# SQLite by default (zero install). PostgreSQL + PostGIS for deployment:
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# --- authentication -------------------------------------------------------
# MUST be 32+ characters. If left weak the app generates a random one at
# startup and warns; sessions then die on restart and multiple workers will
# not share them. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
TOKEN_TTL_HOURS=12

# Three roles. Replace with your department directory before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# Mutations always require a token. Set true to require one for reads too.
AUTH_ENFORCE_READS=false

# --- analytics ------------------------------------------------------------
# Frame sampling interval per camera (ms). Higher = fewer cameras' worth of
# GPU/CPU used per stream.
SAMPLE_INTERVAL_MS=400
MIN_PLATE_CONFIDENCE=0.5

# Cameras auto-started on boot, and the gap between each starting. Staggering
# stops N decoders spiking memory at once.
#   -1  start every camera that has an RTSP or HLS URL
#    0  start none, wait for an operator to press Start All
#   >0  cap, for constrained machines
# Note 0 means NONE, not "no limit" — it is what leaves the live wall dark.
AUTOSTART_MAX_CAMERAS=-1
AUTOSTART_STAGGER_MS=800

# Prune detections older than this (minutes) so a long session cannot grow the
# database without bound. 0 disables.
DETECTION_RETENTION_MIN=240

# --- inference device -----------------------------------------------------
# Where the models run: auto | cuda | cpu.
#   auto  use the GPU when a real probe succeeds, else fall back to CPU
#   cuda  require the GPU, and log an error rather than degrade quietly
#   cpu   never touch the GPU
# Needs onnxruntime-gpu; see requirements-ml.txt. With the plain CPU wheel,
# auto correctly resolves to cpu.
INFERENCE_DEVICE=auto
CUDA_DEVICE_ID=0
# Cap the CUDA arena in MB. Every camera worker shares one session, so this is
# a process-wide budget. 0 means no cap. On a 4 GB card driving a desktop,
# 3000 leaves headroom for the display.
CUDA_MEM_LIMIT_MB=0

# --- edge tier ------------------------------------------------------------
# The same codebase runs as the central server or as a district node. On a
# node set EDGE_MODE=true and point EDGE_CENTRAL_URL at the centre; detections
# spool locally when the uplink drops and drain when it returns.
EDGE_MODE=false
EDGE_NODE_ID=edge-01
EDGE_CENTRAL_URL=
EDGE_TOKEN=
EDGE_SPOOL_MAX_ROWS=100000

# --- Sentinel camera grid -------------------------------------------------
# Government sandbox feeds. RTSP, HLS and the catalogue all sit behind the
# access login; paste the session cookie from cctv.corp8.cloud to let
# sync-grid read the live catalogue instead of falling back to cam01..cam30.
GRID_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
GRID_RTSP_BASE=rtsp://103.250.160.189:8554/stream
GRID_HLS_BASE=https://cctv.corp8.cloud
GRID_WHEP_BASE=http://103.250.160.189:8889/stream
# GRID_ACCESS_COOKIE=session=...
# Grid media auth (integrator guide): RTSP & WHEP embed your registered email
# + access password in the URL. Only approved-list emails connect.
# GRID_EMAIL=you@example.com
# GRID_PASSWORD=your-access-password

# --- sandbox --------------------------------------------------------------
# Generate synthetic detections when the grid is unreachable, so the console
# is demonstrable without live feeds.
DEMO_SIMULATE=false

# Low-latency viewing gateway
GO2RTC_URL=http://localhost:1984

# --- optional copilot -----------------------------------------------------
# OpenRouter key activates the agentic copilot. Left blank the UI shows a hint.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
