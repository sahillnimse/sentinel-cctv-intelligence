# Copy to .env and adjust. All values have working defaults for local dev.

# SQLite by default (zero install). For Postgres/PostGIS later:
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

JWT_SECRET=change-me-in-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ANPR frame sampling interval per camera (milliseconds)
SAMPLE_INTERVAL_MS=400

# Minimum OCR confidence to record a sighting (0-1)
MIN_PLATE_CONFIDENCE=0.5

# go2rtc web UI base (for live low-latency viewing in the dashboard)
GO2RTC_URL=http://localhost:1984

# Sentinel camera grid (defaults match the integrator guide; RTSP needs no auth)
GRID_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
GRID_RTSP_BASE=rtsp://103.250.160.189:8554/stream
GRID_HLS_BASE=https://cctv.corp8.cloud
GRID_WHEP_BASE=http://103.250.160.189:8889/stream
# Optional: session cookie from your browser after logging in at cctv.corp8.cloud,
# lets sync-grid read the live catalogue instead of falling back to cam01..cam30.
# GRID_ACCESS_COOKIE=session=abc123...
